{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@packages/standards": ["../packages/standards/src/index.ts"],
      "@packages/standards/*": ["../packages/standards/src/*"],
      "@packages/events": ["../packages/events/src/index.ts"],
      "@packages/events/*": ["../packages/events/src/*"],
      "@packages/auth": ["../packages/auth/src/index.ts"],
      "@packages/auth/*": ["../packages/auth/src/*"],
      "@packages/rbac": ["../packages/rbac/src/index.ts"],
      "@packages/rbac/*": ["../packages/rbac/src/*"]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
